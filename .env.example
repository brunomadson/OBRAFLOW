# Copie este arquivo para .env.local e preencha com os valores reais do seu
# projeto Supabase (Dashboard > Project Settings > API). Nunca commite
# .env.local — ele já está no .gitignore.

# ── Públicas (usadas pelo app Next.js, ficam no bundle do navegador) ────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL de produção do app, sem barra no final (ex. https://obraflow-silk.vercel.app).
# Usada só no backend (webhook de pagamento) pra montar o link de convite —
# lá não existe window.location.origin como no client.
NEXT_PUBLIC_SITE_URL=

# ── Privadas (só scripts locais em Node — seed-*.mjs, check-schema.mjs, ────
#    run-migration.mjs, add-cor.mjs — via supabase-admin.mjs. NUNCA usar
#    dentro de src/, NUNCA expor ao navegador) ──────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Monitoramento de erros (Sentry) — opcional, tudo funciona sem isso ──────
#    Sem essas variáveis o SDK fica desativado (nenhuma rede, nenhum custo).
#    Ver MONITORAMENTO.md pra saber como ativar quando decidirem usar.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Webhook de pagamento (Sprint 9) — segredo por gateway ───────────────────
#    Cada gateway configurado em /api/webhooks/payment?provider=<nome> tem
#    sua própria variável. Sem isso, o webhook recusa qualquer evento
#    daquele provider (ver src/services/payments/providers/*.provider.ts).
CAKTO_WEBHOOK_SECRET=

# ── Integrações (Sprint 11.1) ────────────────────────────────────────────────
# Chave usada pra cifrar/decifrar credencial de integração (token OAuth
# etc.) antes de gravar em workspace_integracoes.credentials_encrypted —
# nunca fica em texto claro no banco. Gerar com: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=

# OAuth do Google (Drive + Calendar, mesmo projeto no Google Cloud Console).
# Sem isso, connect() dessas duas integrações lança erro explícito — código
# pronto, mas sem projeto Google Cloud configurado ainda.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
